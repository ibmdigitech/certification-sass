datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id                       Int                       @id @default(autoincrement())
  name                     String
  logo                     String?
  prefix                   String?
  subscriptionPlan         String?
  users                    User[]
  customers                Customer[]
  jobs                     Job[]
  roles                    Role[]
  trainees                 Trainee[]
  documents                Document[]
  timesheets               Timesheet[]
  certificateVerifications CertificateVerification[]
  reschedules              Reschedule[]
  inspections              Inspection[]
  trainings                Training[]
  trainingSessions         TrainingSession[]
  certificates             Certificate[]
  checklistTemplates       ChecklistTemplate[]
  checklistResults         ChecklistResult[]
  revisions                Revision[]
  payments                 Payment[]
  invoices                 Invoice[]
  deliveryLogs             DeliveryLog[]
  auditLogs                AuditLog[]
  authSessions             AuthSession[]
  traineeDocuments         TraineeDocument[]
  inspectionReports        InspectionReport[]
  inspectionReportTemplates InspectionReportTemplate[]
  inspectionReportSignatures InspectionReportSignature[]
  failureWorkflows         FailureWorkflow[]
  failureWorkflowSteps     FailureWorkflowStep[]
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  companyId   Int
  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([name, companyId])
}

model Permission {
  id          Int                      @id @default(autoincrement())
  name        String                   @unique
  description String?
  category    String?
  roles       RolePermission[]
  overrides   UserPermissionOverride[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model UserPermissionOverride {
  id           Int        @id @default(autoincrement())
  userId       Int
  user         User       @relation(fields: [userId], references: [id])
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  granted      Boolean    @default(true)

  @@unique([userId, permissionId])
}

model User {
  id                          Int                      @id @default(autoincrement())
  name                        String
  email                       String                   @unique
  passwordHash                String
  role                        String
  roleId                      Int?
  roleRef                     Role?                    @relation(fields: [roleId], references: [id])
  companyId                   Int
  company                     Company                  @relation(fields: [companyId], references: [id])
  lastLogin                   DateTime?
  status                      String                   @default("active")
  jobs                        Job[]                    @relation("EngineerJobs")
  reschedules                 Reschedule[]             @relation("RescheduledBy")
  checklistResults            ChecklistResult[]
  revisions                   Revision[]               @relation("ApprovedBy")
  auditLogs                   AuditLog[]
  authSessions                AuthSession[]
  permissionOverrides         UserPermissionOverride[]
  timesheets                  Timesheet[]              @relation("TimesheetUser")
  approvedTimesheets          Timesheet[]              @relation("TimesheetApprover")
  generatedReports            InspectionReport[]       @relation("ReportGeneratedBy")
  reviewedReports             InspectionReport[]       @relation("ReportReviewedBy")
  approvedReports             InspectionReport[]       @relation("ReportApprovedBy")
  signedReports               InspectionReport[]       @relation("ReportSignedBy")
  reportSignatures            InspectionReportSignature[]
  assignedFailureWorkflows    FailureWorkflow[]        @relation("FailureWorkflowAssignee")
  resolvedFailureWorkflows    FailureWorkflow[]        @relation("FailureWorkflowResolvedBy")
  completedFailureSteps       FailureWorkflowStep[]    @relation("FailureStepCompletedBy")
  assignedFailureSteps        FailureWorkflowStep[]    @relation("FailureStepAssignee")
  createdTemplates            InspectionReportTemplate[] @relation("TemplateCreatedBy")
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
}

model Customer {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  contact   String?
  email     String?
  phone     String?
  jobs      Job[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id               Int               @id @default(autoincrement())
  companyId        Int
  company          Company           @relation(fields: [companyId], references: [id])
  customerId       Int
  customer         Customer          @relation(fields: [customerId], references: [id])
  jobNumber        String            @unique
  type             String?
  status           String            @default("pending")
  scheduledDate    DateTime?
  engineerId       Int?
  engineer         User?             @relation("EngineerJobs", fields: [engineerId], references: [id])
  cancelReason     String?
  incompleteReason String?
  reschedules      Reschedule[]
  inspections      Inspection[]
  trainings        Training[]
  trainingSessions TrainingSession[]
  certificates     Certificate[]
  payments         Payment[]
  checklistResults ChecklistResult[]
  timesheets       Timesheet[]
  inspectionReports        InspectionReport[]
  failureWorkflows         FailureWorkflow[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Reschedule {
  id            Int       @id @default(autoincrement())
  companyId     Int
  company       Company   @relation(fields: [companyId], references: [id])
  jobId         Int
  job           Job       @relation(fields: [jobId], references: [id])
  reason        String?
  suggestedDate DateTime?
  approvedDate  DateTime?
  rescheduledBy Int?
  user          User?     @relation("RescheduledBy", fields: [rescheduledBy], references: [id])
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Inspection {
  id               Int      @id @default(autoincrement())
  companyId        Int
  company          Company  @relation(fields: [companyId], references: [id])
  jobId            Int
  job              Job      @relation(fields: [jobId], references: [id])
  checklistResults Json?
  result           String?
  attachments      String[]
  reports          InspectionReport[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Training {
  id               Int               @id @default(autoincrement())
  companyId        Int
  company          Company           @relation(fields: [companyId], references: [id])
  jobId            Int
  job              Job               @relation(fields: [jobId], references: [id])
  module           String?
  result           String?
  attachments      String[]
  trainingSessions TrainingSession[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model TrainingSession {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  jobId       Int
  job         Job       @relation(fields: [jobId], references: [id])
  traineeId   Int
  trainee     Trainee   @relation(fields: [traineeId], references: [id])
  trainingId  Int?
  training    Training? @relation(fields: [trainingId], references: [id])
  sessionDate DateTime
  duration    Int?
  topic       String?
  status      String    @default("scheduled")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Certificate {
  id                  Int                       @id @default(autoincrement())
  companyId           Int
  company             Company                   @relation(fields: [companyId], references: [id])
  jobId               Int
  job                 Job                       @relation(fields: [jobId], references: [id])
  jobNumber           String
  sequence            Int
  number              String                    @unique
  revision            Int                       @default(0)
  pdfUrl              String?
  qrUrl               String?
  status              String?
  complianceAuthority String?
  revisions           Revision[]
  deliveryLogs        DeliveryLog[]
  verifications       CertificateVerification[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([jobId, sequence])
}

model ChecklistTemplate {
  id              Int               @id @default(autoincrement())
  companyId       Int
  company         Company           @relation(fields: [companyId], references: [id])
  certificateType String
  authority       String?
  items           Json
  results         ChecklistResult[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model ChecklistResult {
  id         Int               @id @default(autoincrement())
  companyId  Int
  company    Company           @relation(fields: [companyId], references: [id])
  jobId      Int
  job        Job               @relation(fields: [jobId], references: [id])
  itemId     Int
  template   ChecklistTemplate @relation(fields: [itemId], references: [id])
  status     String?
  remarks    String?
  verifiedBy Int?
  user       User?             @relation(fields: [verifiedBy], references: [id])
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model Revision {
  id            Int         @id @default(autoincrement())
  companyId     Int
  company       Company     @relation(fields: [companyId], references: [id])
  certificateId Int
  certificate   Certificate @relation(fields: [certificateId], references: [id])
  rootCause     String?
  oldValue      String?
  newValue      String?
  approvedBy    Int?
  user          User?       @relation("ApprovedBy", fields: [approvedBy], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Payment {
  id        Int       @id @default(autoincrement())
  companyId Int
  company   Company   @relation(fields: [companyId], references: [id])
  jobId     Int
  job       Job       @relation(fields: [jobId], references: [id])
  amount    Float
  method    String?
  status    String?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Invoice {
  id            Int      @id @default(autoincrement())
  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id])
  paymentId     Int
  payment       Payment  @relation(fields: [paymentId], references: [id])
  invoiceNumber String   @unique
  pdfUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DeliveryLog {
  id            Int         @id @default(autoincrement())
  companyId     Int
  company       Company     @relation(fields: [companyId], references: [id])
  certificateId Int
  certificate   Certificate @relation(fields: [certificateId], references: [id])
  deliveryDate  DateTime?
  method        String?
  status        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id])
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   Int?
  tenantId   Int
  timestamp  DateTime @default(now())
}

model AuthSession {
  id        Int       @id @default(autoincrement())
  companyId Int
  company   Company   @relation(fields: [companyId], references: [id])
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiry    DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
}

model Trainee {
  id               Int               @id @default(autoincrement())
  companyId        Int
  company          Company           @relation(fields: [companyId], references: [id])
  firstName        String
  lastName         String
  email            String?
  phone            String?
  employeeId       String?
  department       String?
  position         String?
  hireDate         DateTime?
  status           String            @default("active")
  documents        TraineeDocument[]
  trainingSessions TrainingSession[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([email, companyId])
  @@unique([employeeId, companyId])
}

model TraineeDocument {
  id         Int       @id @default(autoincrement())
  companyId  Int
  company    Company   @relation(fields: [companyId], references: [id])
  traineeId  Int
  trainee    Trainee   @relation(fields: [traineeId], references: [id])
  name       String
  type       String
  url        String
  expiryDate DateTime?
  status     String    @default("valid")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Timesheet {
  id           Int      @id @default(autoincrement())
  companyId    Int
  company      Company  @relation(fields: [companyId], references: [id])
  userId       Int
  user         User     @relation("TimesheetUser", fields: [userId], references: [id])
  jobId        Int?
  job          Job?     @relation(fields: [jobId], references: [id])
  date         DateTime
  startTime    DateTime
  endTime      DateTime
  breakMinutes Int      @default(0)
  description  String?
  status       String   @default("draft")
  approvedBy   Int?
  approver     User?    @relation("TimesheetApprover", fields: [approvedBy], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CertificateVerification {
  id            Int         @id @default(autoincrement())
  companyId     Int
  company       Company     @relation(fields: [companyId], references: [id])
  certificateId Int
  certificate   Certificate @relation(fields: [certificateId], references: [id])
  verifiedBy    String
  verifiedAt    DateTime    @default(now())
  method        String
  result        String
  notes         String?
  createdAt     DateTime    @default(now())
}

model Document {
  id         Int      @id @default(autoincrement())
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  type       String
  category   String?
  url        String
  size       Int?
  mimeType   String?
  entityType String?
  entityId   Int?
  uploadedBy Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model InspectionReport {
  id               Int       @id @default(autoincrement())
  companyId        Int
  company          Company   @relation(fields: [companyId], references: [id])
  jobId            Int
  job              Job       @relation(fields: [jobId], references: [id])
  inspectionId     Int
  inspection       Inspection @relation(fields: [inspectionId], references: [id])
  templateId       Int?
  template         InspectionReportTemplate? @relation(fields: [templateId], references: [id])
  reportNumber     String    @unique
  title            String
  status           String    @default("draft")
  content          Json?
  findings         Json?
  recommendations  Json?
  pdfUrl           String?
  pdfGeneratedAt   DateTime?
  generatedBy      Int?
  generator        User?     @relation("ReportGeneratedBy", fields: [generatedBy], references: [id])
  reviewedBy       Int?
  reviewer         User?     @relation("ReportReviewedBy", fields: [reviewedBy], references: [id])
  approvedBy       Int?
  approver         User?     @relation("ReportApprovedBy", fields: [approvedBy], references: [id])
  signedAt         DateTime?
  signedBy         Int?
  signer           User?     @relation("ReportSignedBy", fields: [signedBy], references: [id])
  signatureData    Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  signatures       InspectionReportSignature[]
  failureWorkflows FailureWorkflow[]

  @@index([companyId, jobId])
  @@index([companyId, inspectionId])
  @@index([status])
}

model InspectionReportTemplate {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  name        String
  description String?
  type        String
  content     Json
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdBy   Int?
  creator     User?     @relation("TemplateCreatedBy", fields: [createdBy], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reports     InspectionReport[]

  @@index([companyId, type])
  @@index([companyId, isDefault])
}

model InspectionReportSignature {
  id            Int       @id @default(autoincrement())
  companyId     Int
  company       Company   @relation(fields: [companyId], references: [id])
  reportId      Int
  report        InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId        Int
  user          User      @relation(fields: [userId], references: [id])
  role          String
  signatureData Json
  signedAt      DateTime  @default(now())
  ipAddress     String?
  userAgent     String?

  @@index([reportId])
  @@index([userId])
}

model FailureWorkflow {
  id              Int       @id @default(autoincrement())
  companyId       Int
  company         Company   @relation(fields: [companyId], references: [id])
  reportId        Int
  report          InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  jobId           Int
  job             Job       @relation(fields: [jobId], references: [id])
  type            String
  title           String
  description     String?
  status          String    @default("open")
  priority        String    @default("medium")
  assignedTo      Int?
  assignee        User?     @relation("FailureWorkflowAssignee", fields: [assignedTo], references: [id])
  rootCause       String?
  correctiveAction String?
  preventiveAction String?
  dueDate         DateTime?
  resolvedAt      DateTime?
  resolvedBy      Int?
  resolver        User?     @relation("FailureWorkflowResolvedBy", fields: [resolvedBy], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  steps           FailureWorkflowStep[]

  @@index([companyId, jobId])
  @@index([companyId, status])
  @@index([assignedTo])
}

model FailureWorkflowStep {
  id               Int       @id @default(autoincrement())
  companyId        Int
  company          Company   @relation(fields: [companyId], references: [id])
  workflowId       Int
  workflow         FailureWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepNumber       Int
  title            String
  description      String?
  status           String    @default("pending")
  assignedTo       Int?
  assignee         User?     @relation("FailureStepAssignee", fields: [assignedTo], references: [id])
  completedAt      DateTime?
  completedBy      Int?
  completer        User?     @relation("FailureStepCompletedBy", fields: [completedBy], references: [id])
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workflowId])
  @@unique([workflowId, stepNumber])
}

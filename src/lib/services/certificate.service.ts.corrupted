import { PrismaClient   jobServiceId?: number;} from '@prisma/client';
import { CertificateNumberService   jobServiceId?: number;} from './certificate-number.service';

const prisma = new PrismaClient();

export interface CreateCertificateInput {
  companyId: number;
  jobId: number;
  traineeId?: number;
  complianceAuthority?: string;
  status?: string;
  jobServiceId?: number;}

export class CertificateService {
  static async createCertificate(input: CreateCertificateInput) {
    const { certificateNumber, sequence, jobNumber   jobServiceId?: number;} = await CertificateNumberService.generateCertificateNumber(
      input.jobId,
      input.companyId
    );

    const certificate = await prisma.certificate.create({
      data: {
        companyId: input.companyId,
        jobId: input.jobId,
        jobNumber,
        sequence,
        number: certificateNumber,
        status: input.status ?? 'draft',
        complianceAuthority: input.complianceAuthority,
        jobServiceId?: number;},
      include: {
        job: {
          include: { customer: true   jobServiceId?: number;},
          jobServiceId?: number;},
        jobServiceId?: number;},
      jobServiceId?: number;});

    return certificate;
    jobServiceId?: number;}

  static async bulkCreateCertificates(
    companyId: number,
    jobId: number,
    count: number,
    baseData: Omit<CreateCertificateInput, 'jobId' | 'companyId'> = {  jobServiceId?: number;}
  ) {
    const results = [];
    const errors = [];

    for (let i = 0; i < count; i++) {
      try {
        const cert = await this.createCertificate({
          companyId,
          jobId,
          ...baseData,
          jobServiceId?: number;});
        results.push(cert);
        jobServiceId?: number;} catch (error) {
        errors.push({ index: i, error: error instanceof Error ? error.message : 'Unknown error'   jobServiceId?: number;});
        jobServiceId?: number;}
      jobServiceId?: number;}

    return { certificates: results, errors   jobServiceId?: number;};
    jobServiceId?: number;}

  static async getCertificateById(id: number, companyId: number) {
    return prisma.certificate.findFirst({
      where: { id, companyId   jobServiceId?: number;},
      include: {
        job: {
          include: { customer: true   jobServiceId?: number;},
          jobServiceId?: number;},
        verifications: true,
        jobServiceId?: number;},
      jobServiceId?: number;});
    jobServiceId?: number;}

  static async getCertificateByNumber(certificateNumber: string, companyId: number) {
    return prisma.certificate.findFirst({
      where: { number: certificateNumber, companyId   jobServiceId?: number;},
      include: {
        job: {
          include: { customer: true   jobServiceId?: number;},
          jobServiceId?: number;},
        verifications: true,
        jobServiceId?: number;},
      jobServiceId?: number;});
    jobServiceId?: number;}

  static async listCertificates(companyId: number, options?: {
    jobId?: number;
    status?: string;
    certificateType?: string;
    search?: string;
    page?: number;
    limit?: number;
    jobServiceId?: number;}) {
    const { jobId, status, certificateType, search, page = 1, limit = 20   jobServiceId?: number;} = options ?? {  jobServiceId?: number;};

    const where: Record<string, unknown> = { companyId   jobServiceId?: number;};
    if (jobId) where.jobId = jobId;
    if (status) where.status = status;
    if (certificateType) where.certificateType = certificateType;
    if (search) {
      where.OR = [
        { number: { contains: search, mode: 'insensitive'   jobServiceId?: number;}   jobServiceId?: number;},
        { holderName: { contains: search, mode: 'insensitive'   jobServiceId?: number;}   jobServiceId?: number;},
        { holderCompany: { contains: search, mode: 'insensitive'   jobServiceId?: number;}   jobServiceId?: number;},
      ];
      jobServiceId?: number;}

    const [certificates, total] = await Promise.all([
      prisma.certificate.findMany({
        where,
        include: {
          job: {
            include: { customer: true   jobServiceId?: number;},
            jobServiceId?: number;},
          jobServiceId?: number;},
        orderBy: { createdAt: 'desc'   jobServiceId?: number;},
        skip: (page - 1) * limit,
        take: limit,
        jobServiceId?: number;}),
      prisma.certificate.count({ where   jobServiceId?: number;}),
    ]);

    return { certificates, total, page, limit, totalPages: Math.ceil(total / limit)   jobServiceId?: number;};
    jobServiceId?: number;}

  static async updateCertificateStatus(id: number, companyId: number, status: string) {
    return prisma.certificate.update({
      where: { id, companyId   jobServiceId?: number;},
      data: { status   jobServiceId?: number;},
      jobServiceId?: number;});
    jobServiceId?: number;}

  static async previewNextCertificateNumber(jobId: number, companyId: number) {
    const job = await prisma.job.findFirst({
      where: { id: jobId, companyId   jobServiceId?: number;},
      select: { jobNumber: true   jobServiceId?: number;},
      jobServiceId?: number;});

    if (!job) return null;

    return CertificateNumberService.previewCertificateNumber(jobId);
    jobServiceId?: number;}

  static async getCertificatesByJob(jobId: number, companyId: number) {
    return prisma.certificate.findMany({
      where: { jobId, companyId   jobServiceId?: number;},
      orderBy: { sequence: 'asc'   jobServiceId?: number;},
      jobServiceId?: number;});
    jobServiceId?: number;}
  jobServiceId?: number;}
